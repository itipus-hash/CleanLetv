    <string name="greeting_name_state">Greeting name: %1$s</string>
    <string name="greeting_name_none">No name</string>
    <string name="greeting_name_theme_default">Theme default</string>
    <string name="greeting_name_hint">Shown after the greeting, e.g. 下午好，许多鱼. Leave it empty to show the greeting alone.</string>
    <string name="weather_city_label">Weather city</string>
    <string name="weather_city_state">Weather city: %1$s</string>
    <string name="weather_city_auto">Locate me</string>
    <string name="weather_city_hint">The city the weather line names. Leave it empty to work it out from the network address, or type a name to override, e.g. 泉州市.</string>
    <string name="weather_key_label">QWeather API key</string>
    <string name="weather_key_state">QWeather API key: %1$s</string>
    <string name="weather_key_none">Not set</string>
    <string name="weather_key_set">Set</string>
    <string name="weather_key_hint">The weather line needs it. Get one free at dev.qweather.com (console → project → create credential → API KEY). Leave it empty and no line is shown.</string>
    <string name="weather_host_label">QWeather API host</string>
    <string name="weather_host_state">QWeather API host: %1$s</string>
    <string name="weather_host_hint">Where the requests go, issued per account (console → settings). Keep api.qweather.com unless your console shows another — QWeather is retiring the public domains.</string>
    <string name="weather_mode_state">Weather on Home: %1$s</string>
    <string name="weather_mode_title">Weather on Home</string>
    <string name="weather_mode_hint">Which weather lines Home draws under the clock. Off hides every line and stops the network; the city and the key stay, so it can be switched back on at any time.</string>
    <string name="weather_mode_off">Off</string>
    <string name="weather_mode_sky">Sky only</string>
    <string name="weather_mode_extra">Sky + humidity and ultraviolet</string>
    <string name="weather_mode_sun">Sky + sunrise and sunset</string>
    <string name="weather_mode_extra_sun">Sky + humidity and ultraviolet + sunrise and sunset</string>
    <string name="stats_state">System stats: %1$s</string>
    <string name="stats_hint">The line under the clock with CPU, memory and free storage. Off means it is not read and not shown.</string>
    <string name="hitokoto_state">Show the daily sentence on Home: %1$s</string>
    <string name="hitokoto_hint">A sentence in the top right corner of Home, with its source under it. It comes from the library shipped inside the app, so no network is needed; the same one all day.</string>
    <string name="hitokoto_title">Daily sentence</string>
    <string name="hitokoto_categories">Sentence categories (Home)</string>
    <string name="hitokoto_categories_state">Sentence categories (Home): %1$s</string>
    <string name="hitokoto_categories_all">All</string>
    <string name="category_separator">、</string>
    <string name="hitokoto_categories_help">The sentence in Home\'s top right corner draws only from the ticked categories, the same one all day. Independent of the Le key set.</string>
    <string name="le_key_categories">Sentence categories (Le key)</string>
    <string name="le_key_categories_state">Sentence categories (Le key): %1$s</string>
    <string name="le_key_categories_help">Both Le-key panels - the one drawn over Home and the one drawn over an app - draw only from the ticked categories, a new sentence on every open. Independent of the line in Home\'s corner.</string>
    <string name="hitokoto_categories_hint">OK ticks or unticks, Back closes</string>
    <string name="le_key_function">Le key (in apps)</string>
    <string name="le_key_function_state">Le key (in apps): %1$s</string>
    <string name="le_key_function_help">What the Le key opens while an app is in front. App library: the app list, as before. Daily sentence: the same panel with a random sentence on every open.</string>
    <string name="home_le_key_function">Le key (on Home)</string>
    <string name="home_le_key_function_state">Le key (on Home): %1$s</string>
    <string name="home_le_key_function_help">What the Le key opens on Home itself. The panel is drawn over Home and the focus goes back to the tile you pressed it from. Separate from the in-app row, so the two places can differ.</string>
    <string name="le_quote_close_hint">OK or Back closes</string>
    <string name="voice_key_label">Voice button app</string>
    <string name="voice_key_state">Voice button app: %1$s</string>
    <string name="voice_key_none">Not set</string>
    <string name="voice_key_hint">The remote\'s voice button (under the share button) opens this app. The first press asks you to pick one; change it here any time.</string>
    <string name="voice_key_ask_title">Which app should the voice button open?</string>
    <string name="voice_key_ask_message">Change it later in Launcher settings</string>
    <string name="voice_key_gone">%1$s no longer opens. Pick another app.</string>
    <string name="library_button_state">App library button: %1$s</string>
    <string name="library_button_hint">The nine-dot button in the top bar. Off leaves Wi-Fi and Settings there, and the library still opens from the last row of the grid.</string>
